#!/bin/sh

d=/sys/kernel/debug
grep -q " $d " /proc/mounts || mount -t debugfs none $d

s() { printf '\n== %s\n' "$1"; }

ps_on() {
	v=$(devmem "$1" 32)
	[ $(( (v >> 4) & 0xf )) -eq 15 ]
}

s kernel
uname -a
cat /proc/cmdline

s dmesg
dmesg | grep -iE 'hsic|ehci|usb|smsc|eth|gpio|pmic|i2c|bluetooth|hci|serial|ttySAC|phy|pmgr|genpd|fail|error'

s gpio
cat $d/gpio

s pmgr
for n in usb:0x20e020248 usbctrl:0x20e020250 usb2host2:0x20e020278 hsic1_phy:0x20e020208 uart1:0x20e0201a8 uart3:0x20e0201b8; do
	printf '%-10s %s\n' "${n%%:*}" "$(devmem "${n#*:}" 32)"
done

if ps_on 0x20e020278 && ps_on 0x20e020208; then
	s hsic
	for a in 0x20c000018 0x20c00001c 0x20c000060 0x20c000064 0x20c000068 0x20c00006c 0x20c90009c; do
		printf '%s %s\n' "$a" "$(devmem "$a" 32)"
	done
	s ehci
	cat $d/usb/ehci/*/registers 2>/dev/null
fi

s usb
lsusb
for u in /sys/bus/usb/devices/*; do
	[ -f "$u/idVendor" ] && printf '%s %s:%s %s\n' "${u##*/}" "$(cat "$u/idVendor")" "$(cat "$u/idProduct")" "$(cat "$u/product" 2>/dev/null)"
done

s net
ip addr

s bluetooth
ls /sys/class/bluetooth 2>/dev/null
