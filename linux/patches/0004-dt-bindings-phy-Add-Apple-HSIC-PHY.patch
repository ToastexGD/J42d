From a469f1039de7297e0e7380678c9bc96a1d72280d Mon Sep 17 00:00:00 2001
From: ToastexGD <toastexgdm@gmail.com>
Date: Wed, 7 Oct 2026 17:29:02 -0400
Subject: [PATCH] dt-bindings: phy: Add Apple HSIC PHY

---
 .../bindings/phy/apple,hsic-phy.yaml          | 70 +++++++++++++++++++
 1 file changed, 70 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/apple,hsic-phy.yaml

diff --git a/Documentation/devicetree/bindings/phy/apple,hsic-phy.yaml b/Documentation/devicetree/bindings/phy/apple,hsic-phy.yaml
new file mode 100644
index 000000000..e40ef4fb8
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/apple,hsic-phy.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/apple,hsic-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple HSIC PHY
+
+maintainers:
+  - ToastexGD <toastexgdm@gmail.com>
+
+description:
+  HSIC PHY found on Apple A7 and A8 SoCs, sitting between an EHCI
+  controller of the USB complex and an onboard HSIC device such as
+  the LAN9730 Ethernet controller on the Apple TV HD.
+
+properties:
+  compatible:
+    items:
+      - enum:
+          - apple,s5l8960x-hsic-phy
+          - apple,t7000-hsic-phy
+      - const: apple,hsic-phy
+
+  reg:
+    minItems: 1
+    items:
+      - description: HSIC port control registers
+      - description: control registers of the EHCI the port belongs to
+
+  reg-names:
+    minItems: 1
+    items:
+      - const: hsic
+      - const: ehci
+
+  power-domains:
+    maxItems: 1
+
+  "#phy-cells":
+    const: 0
+
+  apple,cfg:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Port tunable written while bringing up the PHY.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        phy@20c000060 {
+            compatible = "apple,t7000-hsic-phy", "apple,hsic-phy";
+            reg = <0x2 0x0c000060 0x0 0x10>,
+                  <0x2 0x0c000018 0x0 0x8>;
+            reg-names = "hsic", "ehci";
+            power-domains = <&ps_hsic1_phy>;
+            #phy-cells = <0>;
+        };
+    };
