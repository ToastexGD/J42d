From 4431437d0cea2b2665b2b2ebb290ace6f46ae2aa Mon Sep 17 00:00:00 2001
From: ToastexGD <toastexgdm@gmail.com>
Date: Wed, 7 Oct 2026 17:29:01 -0400
Subject: [PATCH] dt-bindings: gpio: Add Apple PMIC GPIO

---
 .../bindings/gpio/apple,pmic-gpio.yaml        | 68 +++++++++++++++++++
 .../devicetree/bindings/mfd/apple,pmic.yaml   |  3 +
 2 files changed, 71 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/gpio/apple,pmic-gpio.yaml

diff --git a/Documentation/devicetree/bindings/gpio/apple,pmic-gpio.yaml b/Documentation/devicetree/bindings/gpio/apple,pmic-gpio.yaml
new file mode 100644
index 000000000..6972c8066
--- /dev/null
+++ b/Documentation/devicetree/bindings/gpio/apple,pmic-gpio.yaml
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpio/apple,pmic-gpio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple PMIC GPIO
+
+maintainers:
+  - ToastexGD <toastexgdm@gmail.com>
+
+description:
+  GPIO block of the Dialog designed PMICs used on Apple A8 devices.
+  This module is part of Apple PMICs, see ../mfd/apple,pmic.yaml.
+
+properties:
+  compatible:
+    const: apple,adi-pmic-gpio
+
+  reg:
+    items:
+      - description: pin configuration registers
+      - description: input level registers
+
+  gpio-controller: true
+
+  "#gpio-cells":
+    const: 2
+
+  gpio-line-names:
+    maxItems: 21
+
+patternProperties:
+  "-hog(-[0-9]+)?$":
+    type: object
+    required:
+      - gpio-hog
+
+required:
+  - compatible
+  - reg
+  - gpio-controller
+  - "#gpio-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    pmic {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        gpio@400 {
+            compatible = "apple,adi-pmic-gpio";
+            reg = <0x400 0x2a>, <0x63 0x3>;
+            gpio-controller;
+            #gpio-cells = <2>;
+
+            lan-reset-hog {
+                gpio-hog;
+                gpios = <10 GPIO_ACTIVE_LOW>;
+                output-low;
+                line-name = "lan-reset";
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
index 8bf64a835..047522f14 100644
--- a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
+++ b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
@@ -58,6 +58,9 @@ patternProperties:
   "^backlight(@[0-9a-f]+)?$":
     $ref: /schemas/leds/backlight/apple,pmic-bl.yaml
 
+  "^gpio(@[0-9a-f]+)?$":
+    $ref: /schemas/gpio/apple,pmic-gpio.yaml
+
   "^rtc(@[0-9a-f]+)?$":
     $ref: /schemas/rtc/apple,pmic-rtc.yaml
 
